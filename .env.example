# CS2 Inspect Server Backend Configuration

# Express Port for the REST API
PORT=3000

# Security token to prevent unauthorized access (Optional but recommended)
# If set, you must include it in headers: Authorization: Bearer <AUTH_KEY>
AUTH_KEY=local_inspect_secret_key

# Steam Account Details (Must own CS2)
STEAM_USERNAME=your_steam_username
STEAM_PASSWORD=your_steam_password

# Steam Guard 2FA Shared Secret (Optional)
# If provided, the bot will generate 2FA login codes automatically.
# You can extract this from your SDA (Steam Desktop Authenticator) or root mobile files.
STEAM_SHARED_SECRET=

# RCON Configurations (Optional, to enable "Send to Server" button from web UI)
RCON_HOST=127.0.0.1
RCON_PORT=27015
RCON_PASSWORD=your_rcon_password

